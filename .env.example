# =====================================================================
#  .env.example — Plantilla de variables de entorno
# =====================================================================
# Para qué sirve:
#   settings.py NO tiene contraseñas escritas. En su lugar lee estos
#   valores desde un archivo ".env". Este archivo de ejemplo muestra
#   QUÉ variables se necesitan, pero sin los valores reales.
#
# Cómo usarlo:
#   1. Copia este archivo y nómbralo ".env"   (copy .env.example .env)
#   2. Reemplaza los valores "cambia-..." por los reales.
#   3. El archivo .env NUNCA se sube a git (está en .gitignore).

# --- Django ---
# Clave secreta para firmar sesiones y tokens CSRF. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambia-esta-clave
# True solo en desarrollo (muestra errores detallados). En producción: False.
DJANGO_DEBUG=True
# Dominios permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos MySQL ---
# Esquema (base de datos) creado en MySQL Workbench.
DB_NAME=techstore_db
# Usuario propio de la app (no se usa root por seguridad: mínimo privilegio).
DB_USER=techstore_user
DB_PASSWORD=cambia-esta-contrasena
# Servidor y puerto de MySQL (127.0.0.1 = este mismo computador).
DB_HOST=127.0.0.1
DB_PORT=3306
